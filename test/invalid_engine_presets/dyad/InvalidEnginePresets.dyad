# INVALID fixtures for tests only. Each wraps the one SimpleDieselEngine with a parameter
# file that must be refused: when the file is loaded, when the engine is constructed, or when
# the run starts.

test component InvalidDecreasingKnots
  extends DyadShip.Propulsion.DieselEnginePorts
  core = DyadShip.Propulsion.SimpleDieselEngine(apply "dyad://DyadShipInvalidEnginePresets/presets/Invalid/decreasing_knots.toml")
relations
  connect(RPM_demand, core.RPM_demand)
  connect(core.KWh, KWh)
  connect(core.Fuel, Fuel)
  connect(core.Fuel_extrapolated, Fuel_extrapolated)
  connect(core.Inst_Fuel, Inst_Fuel)
  connect(core.ShaftPower, ShaftPower)
  connect(core.SFOC_valid, SFOC_valid)
  connect(flange, core.flange)
end

