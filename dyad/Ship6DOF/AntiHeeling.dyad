"""
Clocked on/off state of the anti-heeling pump with hysteresis between
`off_angle` and `max_angle` on the sampled absolute heel.
"""
component AntiHeelingRelay@[input clk extends Discrete]
  "Sampled absolute heel [deg]"
  heel_abs = RealInput@[clk]()
  "Pump command, 1 = on"
  on = RealOutput@[clk]()
  parameter max_angle::Real = 0.1
  parameter off_angle::Real = 0.001
relations
  on@clk = ifelse(on@(clk-1) > 0.5, ifelse(heel_abs@clk < off_angle, 0, 1), ifelse(heel_abs@clk > max_angle, 1, 0))
  initial on@(clk-1) = 0
end

"""
Anti-heeling system applying its righting moment to a 3D hull frame.

Port of `ShipSIM.Components.AntiHeelingSystem.AntiHeeling`. The controller
is the upstream hysteresis (an on/off controller sampled every `dt`
seconds on a `DiscreteComponents.PeriodicClock`): the pump starts when
`|heel|` exceeds `max_angle` and stops again only when the heel has
returned below `off_angle`; the clocked `AntiHeelingRelay` keeps the state
between samples. The pump flow then ramps to `Q` over `ramp_time` seconds,
the upstream triggered trapezoid, through a `BlockComponents` slew-rate
limiter. The pump is held off before `startup_delay`.

The transferred moment `M_tks` integrates the pump flow times the liquid
density and the tank separation `B - b`, saturating at the moment the
overflow volume `0.4 V_tk` can produce, and is applied as a roll moment
`-M_adr g` on `frame_a` by a `WorldTorque` in the ship frame, so a
`ShipBody` rights itself against a steady heeling load. `heel_out` and
`pump_flow` feed `DyadShip.Ship.Tank` models for the tank levels, or
`BallastTank` masses on the hull; in the latter case set `apply_moment =
false` so the moment comes from the water's weight only.
"""
component AntiHeeling
  frame_a = Frame3D()
  "Ship heel [deg], positive starboard down"
  ship_heel = RealInput()
  "Pump flow [m³/h]"
  pump_flow = RealOutput()
  "Righting moment from the system [t m]"
  M_adr = RealOutput()
  "Heel passed on to the tank models [deg]"
  heel_out = RealOutput()
  "1 while the pump is commanded on"
  pump_on = RealOutput()

  ramp = BlockComponents.Nonlinear.SlewRateLimiter(rising = Q / ramp_time, td = 0.05)
  torque = MultibodyComponents.WorldTorque(resolve_in_frame = MultibodyComponents.ResolveInFrame.FrameB())
  sampler = DiscreteComponents.Sampler()
  clock = DiscreteComponents.PeriodicClock(dt = dt)
  relay = AntiHeelingRelay(max_angle = max_angle, off_angle = off_angle)
  hold = DiscreteComponents.ZeroOrderHold(initial_condition = 0)

  "Ship design beam"
  parameter B::Length = 24.3
  "Anti-heeling tank beam"
  parameter b::Length = 6.35
  "Volume of each tank [m³]"
  parameter V_tk::Real = 211.47
  "Liquid density [t/m³]"
  parameter rho::Real = 1.025
  "Pump capacity [m³/h]"
  parameter Q::Real = 200
  "Heel at which the pump starts [deg]"
  parameter max_angle::Real = 0.1
  "Heel below which the pump stops [deg]"
  parameter off_angle::Real = 0.001
  "Ramp-up time of the pump flow [s]"
  parameter ramp_time::Time = 10
  "Pump is held off before this time [s]"
  parameter startup_delay::Time = 500
  "Sampling period of the on/off controller"
  structural parameter dt::Real = 1.0
  parameter g::Acceleration = 9.80665
  "Apply the righting moment as a torque on frame_a. Set false when the tank liquids are modelled as `BallastTank` masses on the hull, which then produce the moment themselves."
  parameter apply_moment::Boolean = true

  "Pump command from the relay, 1 = on"
  variable on::Real
  "Moment produced by the tanks [t m]"
  variable M_tks::Real
  "Maximum overflow volume [m³]"
  variable v_max::Real
  "Maximum moment the tanks can produce [t m]"
  variable M_max::Real
  "Smooth sign of the heel"
  variable sgn::Real
relations
  connect(frame_a, torque.frame_b)
  initial M_tks = 0
  heel_out = ship_heel
  sampler.u = abs(ship_heel)
  connect(sampler.y, relay.heel_abs, clock.y)
  connect(relay.on, hold.u)
  on = hold.y
  pump_on = on
  ramp.u = Q * clamp(on, 0, 1) * ifelse(time < startup_delay, 0, 1)
  pump_flow = ramp.y

  v_max = V_tk * 0.40
  M_max = rho * v_max * (B - b)
  sgn = ship_heel / sqrt(ship_heel^2 + 1e-6)
  der(M_tks) = sgn * pump_flow / 3600 * rho * (B - b)
  M_adr = clamp(M_tks, -M_max, M_max)

  torque.torque_x = ifelse(apply_moment, -M_adr * g * 1000, 0)
  torque.torque_y = 0
  torque.torque_z = 0
end
